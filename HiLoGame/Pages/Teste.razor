@using System.Linq
@page "/teste"
@using MessagePack
@using MessagePack.Resolvers
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager NavigationManager
@inject SessionGaming Sessao;
@implements IAsyncDisposable

<PageTitle>Index</PageTitle>

<h1>Hello, world!</h1>

@if (IsConnecting)
{
    <h1>Connecting !!!!</h1>
}
<div class="form-group">
    <label>
        Group:
        <input @bind="group" />
    </label>
</div>

<div class="form-group">
    <label>
        Player:
        <input @bind="player" />
    </label>
</div>
@if (IsConnected)
{
    <div class="form-group">
        <label>
            Message:
            <input @bind="message" size="50" />
        </label>
    </div>
    <br />
}
<button @onclick="Send" disabled="@(!IsConnected)">Send</button>
<button @onclick="Connect" disabled="@(IsConnected)">Connect</button>
<hr />
<div class="form-group">
    <label>
        Messages:
    </label>
    <ul id="listMessages">
        @foreach (var item in lista)
        {
            <li>
                @item
            </li>
        }
    </ul>
</div>
<div class="form-group">
    <label>
        Players: @listaPlayers.Count
    </label>
    <ul id="listMessages">
        @foreach (var item in listaPlayers)
        {
            <li>
                @item
            </li>
        }
    </ul>
</div>

@code
{
    protected bool IsConnecting = false;
    protected string group = "G1";
    protected string player = "player1";
    protected string message = default;
    string Nome = default!;

    private HubConnection hubConnection = default!;

    protected List<string> lista = new List<string>();
    protected List<string> listaPlayers = new List<string>();

    public bool IsConnected =>
        hubConnection?.State == HubConnectionState.Connected;

    protected override Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Sessao.Player.Name))
        {
            Sessao.Player.Name = "Camilo";
        }

        Nome = Sessao.Player.Name;

        hubConnection = new HubConnectionBuilder()
                            .WithUrl(new Uri($"https://localhost:7228/misterynumber"))
                            .WithAutomaticReconnect()
                            .Build();

        hubConnection.On<string>("ReceiveMessage", (message) =>
        {
            lista.Add(message);

            StateHasChanged();
        });

        hubConnection.On<IEnumerable<string>>("Subscribed", (listSubscribed) =>
        {
            listaPlayers.Add(player!);

            listaPlayers = listaPlayers.Concat(listSubscribed).ToList();

            StateHasChanged();
            Console.WriteLine($"IsSubscribed : " + (listSubscribed.Count() == 0));
        });

        hubConnection.On<string>("PlayerSubscribed", (name) =>
        {
            listaPlayers.Add(name);

            StateHasChanged();
        });

        hubConnection.On<string>("PlayerUnsubscribed", (name) =>
        {
            Console.WriteLine("Unsibscribe : " + name);

            listaPlayers.Remove(name);

            StateHasChanged();
        });

        return base.OnInitializedAsync();
    }

    private async Task Connect()
    {
        if (!IsConnected)
        {
            try
            {
                Console.WriteLine("Connecting ..... ");

                IsConnecting = true;

                await hubConnection.StartAsync();

                await hubConnection.SendAsync("Subscribe", group, player);

                Console.WriteLine("Connected ! ");
            }
            catch (Exception ex)
            {
                StringWriter error = new StringWriter();

                error.WriteLine(ex.Message);

                Console.SetError(error);
            }
            finally
            {
                IsConnecting = false;
            }
        }
    }

    private async Task Send()
    {
        try
        {
            if (hubConnection is not null)
            {
                await hubConnection.SendAsync("SendChatMessage", group, message);
            }
            else
            {
            }
        }
        catch (Exception ex)
        {
            StringWriter error = new StringWriter();

            error.WriteLine(ex.Message);

            Console.SetError(error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}