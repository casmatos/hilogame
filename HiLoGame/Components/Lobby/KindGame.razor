<MudGrid Class="mt-8">
    <MudItem xs="12">
        <MudText Typo="Typo.h6" Align="Align.Center" GutterBottom="true">Choose type of game</MudText>
    </MudItem>
    <MudItem xs="12" sm="6" md="6">
        <div class="kind-game">
            <MudCard Elevation="25" Class="rounded-lg pb-4" @onclick="OnClickSinglePlayer">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" Align="Align.Center">Single</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <div class="d-flex justify-center">
                        <MudImage Src="imgs/player.png" Fluid="true" Class="img-kind-game" Elevation="0" ObjectFit="ObjectFit.Fill" />
                    </div>
                </MudCardContent>
            </MudCard>
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" md="6">
        <div class="kind-game">
            <MudCard Elevation="25" Class="rounded-lg pb-4" @onclick="OnClickMultiPlayer">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" Align="Align.Center">Multi-Player</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <div class="d-flex justify-center">
                        <MudImage Src="imgs/multiplayer.png" Elevation="0" ObjectFit="ObjectFit.Fill" />
                    </div>
                </MudCardContent>
            </MudCard>
        </div>
    </MudItem>
</MudGrid>
@code {
    [Parameter] public EventCallback OnClickSinglePlayer { get; set; }
    [Parameter] public EventCallback OnClickMultiPlayer { get; set; }
}
